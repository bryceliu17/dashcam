# Host folder persisted and mounted at /data inside the containers.
# Windows example: E:/DashcamData
# Linux example: /srv/dashcam-data
DASHCAM_DATA_PATH=./data

# Initial fallbacks used until limits are saved from the dashboard.
DASHCAM_MAX_STORAGE_GB=350
DASHCAM_MAX_AUDIO_STORAGE_GB=20

# Optional speaker separation for generated transcripts.
# First accept the pyannote community-1 terms on Hugging Face, then put a read token here.
HUGGINGFACE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cuda
